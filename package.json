{
	"name": "ivmeapp",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:studio": "turbo run db:studio -F @ivmeapp/db --",
		"db:generate": "turbo run db:generate -F @ivmeapp/db --",
		"db:migrate": "turbo run db:migrate -F @ivmeapp/db --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/server && pnpm run auth:generate",
		"check": "biome check --write .",
		"dev:worker": "turbo run dev -F worker --",
		"db:reset": "./scripts/db-reset.sh",
		"db:seed": "cd apps/server && pnpm db:seed",
		"sub:activate": "cd apps/server && pnpm sub:activate",
		"prod:build": "turbo run build",
		"prod:start": "./scripts/start-prod.sh",
		"test": "turbo test"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@ivmeapp/config": "workspace:*",
		"@types/node": "catalog:",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "pnpm@10.28.0"
}
