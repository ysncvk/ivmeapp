{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsc -b ../../packages/api && tsdown",
		"check-types": "tsc -b ../../packages/api && tsc --noEmit",
		"dev": "tsx watch src/index.ts",
		"db:seed": "tsx src/seed.ts",
		"start": "node dist/index.mjs",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"@ivmeapp/api": "workspace:*",
		"@ivmeapp/auth": "workspace:*",
		"@ivmeapp/db": "workspace:*",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "^4.13.7",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@ivmeapp/config": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.13",
		"typescript": "catalog:"
	}
}
